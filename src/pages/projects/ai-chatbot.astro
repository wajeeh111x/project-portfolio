---
const technologies = [
  "PYTHON",
  "OPENAI",
  "FASTAPI",
  "LLM",
  "API",
];
---

<!doctype html>

<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>AI Chatbot — Syed Wajeeh</title>

  <meta
    name="description"
    content="AI chatbot system built with Python, OpenAI and FastAPI."
  />
</head>


<body>

  <main>

    <!-- BACK -->

    <a href="/#projects" class="back">
      ← BACK TO PROJECTS
    </a>


    <!-- HERO -->

    <section class="project-hero">

      <div class="hero-meta">
        <span>PROJECT / 01</span>
        <span>AI / MACHINE LEARNING</span>
      </div>


      <h1>
        AI<br />
        <span>CHATBOT.</span>
      </h1>


      <p class="intro">
        An intelligent conversational system designed to
        understand natural language, process context and
        generate useful responses in real time.
      </p>


      <!-- SYSTEM -->

      <div class="system">

        <div class="orb">

          <div class="orb-ring ring-1"></div>
          <div class="orb-ring ring-2"></div>
          <div class="orb-ring ring-3"></div>

          <div class="orb-core"></div>

        </div>

        <span class="system-label label-1">AI CORE</span>
        <span class="system-label label-2">ONLINE</span>
        <span class="system-label label-3">01</span>

      </div>

    </section>


    <!-- INFORMATION -->

    <section class="information">

      <div class="info-block">

        <span class="label">
          01 / OVERVIEW
        </span>

        <h2>
          INTELLIGENT
          <span>CONVERSATION.</span>
        </h2>

        <p>
          The system is designed around natural language
          interaction. Users can communicate with the
          application through conversational prompts while
          the backend processes requests and returns
          generated responses.
        </p>

      </div>


      <div class="info-block">

        <span class="label">
          02 / TECHNOLOGY
        </span>

        <div class="technology-grid">

          {
            technologies.map((technology, index) => (
              <div class="technology">
                <span>0{index + 1}</span>
                <strong>{technology}</strong>
              </div>
            ))
          }

        </div>

      </div>


      <div class="info-block">

        <span class="label">
          03 / ARCHITECTURE
        </span>

        <div class="architecture">

          <div>
            <span>USER</span>
          </div>

          <div class="arrow">→</div>

          <div>
            <span>API</span>
          </div>

          <div class="arrow">→</div>

          <div>
            <span>AI MODEL</span>
          </div>

          <div class="arrow">→</div>

          <div>
            <span>RESPONSE</span>
          </div>

        </div>

      </div>

    </section>


    <!-- FOOTER -->

    <footer>

      <span>
        SYED WAJEEH
      </span>

      <span>
        AI / SOFTWARE / DIGITAL
      </span>

      <a href="/#projects">
        ALL PROJECTS ↗
      </a>

    </footer>

  </main>

</body>

</html>

<style>

  * {
    box-sizing: border-box;
  }


  html {
    background: #03050d;
    color: white;
    scroll-behavior: smooth;
  }


  body {
    margin: 0;
    background: #03050d;
    font-family: Arial, Helvetica, sans-serif;
  }


  /* BACK */

  .back {

    position: fixed;

    top: 30px;
    left: 35px;

    z-index: 20;

    color: #66718e;

    text-decoration: none;

    font-family: monospace;

    font-size: 9px;

    letter-spacing: .15em;

    transition:
      color .3s ease;

  }


  .back:hover {
    color: #22d3ee;
  }


  /* HERO */

  .project-hero {

    position: relative;

    min-height: 100vh;

    padding:
      140px 8vw
      100px;

    overflow: hidden;

    border-bottom:
      1px solid
      rgba(255,255,255,.07);

    background:

      radial-gradient(
        circle at 75% 50%,
        rgba(40,70,190,.16),
        transparent 35%
      ),

      #03050d;

  }


  .project-hero::before {

    content: "";

    position: absolute;

    inset: 0;

    background-image:

      linear-gradient(
        rgba(60,100,180,.04) 1px,
        transparent 1px
      ),

      linear-gradient(
        90deg,
        rgba(60,100,180,.04) 1px,
        transparent 1px
      );

    background-size:
      70px 70px;

    pointer-events: none;

  }


  .hero-meta {

    position: relative;

    z-index: 2;

    display: flex;

    justify-content:
      space-between;

    max-width: 650px;

    color: #52607c;

    font-family: monospace;

    font-size: 8px;

    letter-spacing: .16em;

  }


  h1 {

    position: relative;

    z-index: 2;

    margin:
      70px 0 30px;

    font-size:
      clamp(
        70px,
        12vw,
        170px
      );

    line-height: .78;

    letter-spacing:
      -.075em;

    color: #eef2ff;

  }


  h1 span {
    color: #526df4;
  }


  .intro {

    position: relative;

    z-index: 2;

    max-width: 520px;

    color: #78819b;

    font-size: 14px;

    line-height: 1.9;

  }


  /* ORB */

  .system {

    position: absolute;

    right: 10%;
    top: 50%;

    width: 420px;
    height: 420px;

    transform:
      translateY(-50%);

  }


  .orb {

    position: absolute;

    left: 50%;
    top: 50%;

    width: 150px;
    height: 150px;

    transform:
      translate(-50%, -50%);

    border-radius: 50%;

    background:
      radial-gradient(
        circle,
        #6378ed,
        #26377e 45%,
        transparent 70%
      );

    box-shadow:
      0 0 100px
      rgba(65,90,240,.4);

  }


  .orb-ring {

    position: absolute;

    left: 50%;
    top: 50%;

    border-radius: 50%;

    border:
      1px solid
      rgba(0,217,255,.5);

    transform:
      translate(-50%, -50%);

  }


  .ring-1 {

    width: 240px;
    height: 240px;

    animation:
      rotate 8s linear infinite;

  }


  .ring-2 {

    width: 320px;
    height: 320px;

    border-color:
      rgba(120,80,255,.35);

    animation:
      rotate 13s linear infinite reverse;

  }


  .ring-3 {

    width: 400px;
    height: 400px;

    border-color:
      rgba(50,150,255,.15);

    animation:
      rotate 20s linear infinite;

  }


  .orb-core {

    position: absolute;

    left: 50%;
    top: 50%;

    width: 10px;
    height: 10px;

    transform:
      translate(-50%, -50%);

    border-radius: 50%;

    background: white;

    box-shadow:
      0 0 30px white;

  }


  @keyframes rotate {

    to {
      transform:
        translate(-50%, -50%)
        rotate(360deg);
    }

  }


  .system-label {

    position: absolute;

    color: #536486;

    font-family: monospace;

    font-size: 8px;

    letter-spacing: .15em;

  }


  .label-1 {
    top: 40px;
    right: 60px;
  }


  .label-2 {
    bottom: 50px;
    left: 30px;
  }


  .label-3 {
    top: 50%;
    right: 0;
  }


  /* INFORMATION */

  .information {

    max-width: 1200px;

    margin: auto;

    padding:
      130px 30px;

  }


  .info-block {

    padding:
      70px 0;

    border-top:
      1px solid
      rgba(255,255,255,.08);

  }


  .label {

    display: block;

    margin-bottom: 30px;

    color: #22d3ee;

    font-family: monospace;

    font-size: 8px;

    letter-spacing: .18em;

  }


  h2 {

    max-width: 800px;

    margin: 0 0 30px;

    color: #eaf2ff;

    font-size:
      clamp(
        45px,
        7vw,
        90px
      );

    line-height: .88;

    letter-spacing:
      -.06em;

  }


  h2 span {
    display: block;
    color: #526df4;
  }


  .info-block p {

    max-width: 650px;

    color: #74809b;

    font-size: 14px;

    line-height: 1.9;

  }


  /* TECHNOLOGY */

  .technology-grid {

    display: grid;

    grid-template-columns:
      repeat(3, 1fr);

    border-left:
      1px solid
      rgba(255,255,255,.07);

  }


  .technology {

    min-height: 130px;

    padding: 25px;

    display: flex;

    flex-direction: column;

    justify-content:
      space-between;

    border-right:
      1px solid
      rgba(255,255,255,.07);

    border-bottom:
      1px solid
      rgba(255,255,255,.07);

  }


  .technology span {

    color: #45516d;

    font-family: monospace;

    font-size: 8px;

  }


  .technology strong {

    color: #dce6fa;

    font-family: monospace;

    font-size: 12px;

    letter-spacing: .1em;

  }


  /* ARCHITECTURE */

  .architecture {

    display: flex;

    align-items: center;

    flex-wrap: wrap;

    gap: 20px;

  }


  .architecture div:not(.arrow) {

    padding:
      22px 28px;

    color: #dce6fa;

    background:
      rgba(255,255,255,.025);

    border:
      1px solid
      rgba(255,255,255,.08);

    font-family: monospace;

    font-size: 9px;

  }


  .arrow {

    color: #22d3ee;

    font-size: 18px;

  }


  /* FOOTER */

  footer {

    display: flex;

    justify-content:
      space-between;

    align-items: center;

    padding:
      30px 6vw;

    border-top:
      1px solid
      rgba(255,255,255,.08);

    color: #4d5872;

    font-family: monospace;

    font-size: 8px;

    letter-spacing: .12em;

  }


  footer a {

    color: #22d3ee;

    text-decoration: none;

  }


  /* MOBILE */

  @media (max-width: 800px) {

    .project-hero {

      padding:
        120px 25px 80px;

    }


    .hero-meta {

      display: block;
    }


    .hero-meta span {

      display: block;

      margin-bottom: 10px;

    }


    .system {

      position: relative;

      right: auto;
      top: auto;

      width: 300px;
      height: 300px;

      margin:
        70px auto 0;

      transform: none;

      opacity: .7;

    }


    .ring-3 {
      width: 280px;
      height: 280px;
    }


    .ring-2 {
      width: 230px;
      height: 230px;
    }


    .ring-1 {
      width: 180px;
      height: 180px;
    }


    .technology-grid {

      grid-template-columns:
        1fr 1fr;

    }


    footer {

      flex-direction: column;

      align-items:
        flex-start;

      gap: 15px;

    }

  }

</style>