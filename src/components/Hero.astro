---
import AICore from "./AICore";
---

<section class="hero" id="home">

  <!-- BACKGROUND -->
  <div class="hero-grid"></div>
  <div class="hero-noise"></div>

  <!-- TOP NAV -->
  <header class="nav">

    <a href="/" class="brand">
      <span class="brand-mark">◆</span>
      <span>SYED WAJEEH </span>
    </a>

    <div class="nav-links">
      <a href="#projects">PROJECTS</a>
      <a href="#about">ABOUT</a>
      <a href="#contact">CONTACT</a>
    </div>

    <div class="system-status">
      <span class="status-dot"></span>
      SYSTEM ONLINE
    </div>

  </header>


<!-- HERO CONTENT -->
<div class="hero-layout">

  <!-- LEFT -->
  <div class="hero-left">

    <div class="eyebrow">
      <span>01</span>
      <span>AI / SOFTWARE / DIGITAL</span>
    </div>

    <h1>
      BUILDING
      <span class="gradient-text">INTELLIGENT</span>
      SYSTEMS.
    </h1>

    <p class="hero-description">
      I design and engineer AI systems,
      software products and immersive
      digital experiences.
    </p>

    <div class="hero-actions">

      <a href="#projects" class="primary-button">
        <span>EXPLORE PROJECTS</span>
        <span class="arrow">↗</span>
      </a>

      <a href="#about" class="secondary-button">
        ABOUT ME
      </a>

    </div>

  </div>


  <!-- CENTER 3D CORE -->
  <div class="core-area">

    <AICore client:load />

    <!-- DATA POINTS -->
    <div class="data-point point-one">
      <span></span>
      <small>LLM</small>
    </div>

    <div class="data-point point-two">
      <span></span>
      <small>RAG</small>
    </div>

    <div class="data-point point-three">
      <span></span>
      <small>AGENTS</small>
    </div>

    <div class="data-point point-four">
      <span></span>
      <small>VISION</small>
    </div>

  </div>


  <!-- RIGHT SYSTEM PANEL -->
  <div class="system-panel">

    <div class="panel-header">
      <span>PROJECT SYSTEM</span>
      <span>04</span>
    </div>


    <div class="project-mini active">

      <div class="project-number">
        01
      </div>

      <div>
        <strong>AI CHATBOT</strong>
        <small>CONVERSATIONAL AI</small>
      </div>

      <span class="project-status">
        ●
      </span>

    </div>


    <div class="project-mini">

      <div class="project-number">
        02
      </div>

      <div>
        <strong>BUSINESS OS</strong>
        <small>AI AGENTS</small>
      </div>

      <span class="project-status">
        ●
      </span>

    </div>


    <div class="project-mini">

      <div class="project-number">
        03
      </div>

      <div>
        <strong>WEB EXPERIENCE</strong>
        <small>THREE.JS / WEBGL</small>
      </div>

      <span class="project-status">
        ●
      </span>

    </div>


    <div class="project-mini future">

      <div class="project-number">
        04
      </div>

      <div>
        <strong>NEXT BUILD</strong>
        <small>INITIALIZING...</small>
      </div>

      <span class="project-status">
        ◌
      </span>

    </div>

  </div>

</div>



  <!-- BOTTOM BAR -->

  <div class="hero-footer">

    <div>
      <span class="footer-label">LOCATION</span>
      <span>PAKISTAN</span>
    </div>

    <div>
      <span class="footer-label">SPECIALIZATION</span>
      <span>AI × SOFTWARE × WEB</span>
    </div>

    <div>
      <span class="footer-label">STATUS</span>
      <span class="online">AVAILABLE FOR PROJECTS</span>
    </div>

    <div class="scroll-indicator">
      SCROLL
      <span>↓</span>
    </div>

  </div>

</section>


<style>

  /* =========================================
     HERO
  ========================================== */

  .hero {

    position: relative;

    min-height: 100svh;

    height: 100vh;

    overflow: hidden;

    background:
      #050816;

    color:
      #eaf2ff;

    font-family:
      Arial,
      Helvetica,
      sans-serif;

  }


  /* =========================================
     GRID
  ========================================== */

  .hero-grid {

    position: absolute;

    inset: 0;

    background-image:
      linear-gradient(
        rgba(59,130,246,0.07) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(59,130,246,0.07) 1px,
        transparent 1px
      );

    background-size:
      70px 70px;

    mask-image:
      radial-gradient(
        ellipse at center,
        black 20%,
        transparent 80%
      );

    pointer-events:
      none;

  }


  /* =========================================
     NOISE
  ========================================== */

  .hero-noise {

    position: absolute;

    inset: 0;

    opacity:
      0.035;

    pointer-events:
      none;

    background-image:
      url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E");

  }


  /* =========================================
     NAV
  ========================================== */

  .nav {

    position:
      absolute;

    top:
      0;

    left:
      0;

    width:
      100%;

    height:
      80px;

    padding:
      0 40px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    border-bottom:
      1px solid
      rgba(
        255,
        255,
        255,
        0.07
      );

    z-index:
      20;

    background:
      rgba(
        5,
        8,
        22,
        0.35
      );

    backdrop-filter:
      blur(15px);

  }


  .brand {

    display:
      flex;

    align-items:
      center;

    gap:
      10px;

    color:
      white;

    text-decoration:
      none;

    font-size:
      11px;

    font-weight:
      700;

    letter-spacing:
      0.15em;

  }


  .brand-mark {

    color:
      #22d3ee;

    font-size:
      10px;

    text-shadow:
      0 0 15px
      rgba(
        34,
        211,
        238,
        0.9
      );

  }


  .nav-links {

    display:
      flex;

    gap:
      35px;

  }


  .nav-links a {

    color:
      #71809d;

    text-decoration:
      none;

    font-size:
      9px;

    letter-spacing:
      0.15em;

    transition:
      color
      0.3s ease;

  }


  .nav-links a:hover {

    color:
      #22d3ee;

  }


  .system-status {

    display:
      flex;

    align-items:
      center;

    gap:
      8px;

    color:
      #71809d;

    font-size:
      8px;

    letter-spacing:
      0.15em;

  }


  .status-dot {

    width:
      6px;

    height:
      6px;

    border-radius:
      50%;

    background:
      #22d3ee;

    box-shadow:
      0 0 12px
      #22d3ee;

    animation:
      statusPulse
      2s infinite;

  }


  @keyframes statusPulse {

    0%,
    100% {
      opacity:
        1;
    }

    50% {
      opacity:
        0.35;
    }

  }


  /* =========================================
     HERO LAYOUT
  ========================================== */

  .hero-layout {

    position:
      relative;

    z-index:
      5;

    min-height:
      100vh;

    padding:
      120px 40px
      100px;

    display:
      grid;

    grid-template-columns:
      1fr
      1.2fr
      0.7fr;

    align-items:
      center;

    gap:
      30px;

  }


  /* =========================================
     LEFT CONTENT
  ========================================== */

  .hero-left {

    position:
      relative;

    z-index:
      10;

  }


  .eyebrow {

    display:
      flex;

    gap:
      15px;

    margin-bottom:
      35px;

    color:
      #71809d;

    font-size:
      8px;

    letter-spacing:
      0.2em;

  }


  .eyebrow span:first-child {

    color:
      #22d3ee;

  }


  h1 {

    max-width:
      620px;

    margin:
      0;

    font-size:
      clamp(
        55px,
        7vw,
        115px
      );

    line-height:
      0.88;

    letter-spacing:
      -0.065em;

    font-weight:
      700;

  }


  .gradient-text {

    display:
      block;

    background:
      linear-gradient(
        110deg,
        #22d3ee,
        #3b82f6,
        #8b5cf6
      );

    -webkit-background-clip:
      text;

    background-clip:
      text;

    color:
      transparent;

    background-size:
      200% 200%;

    animation:
      gradientMove
      5s ease infinite;

  }


  @keyframes gradientMove {

    0% {
      background-position:
        0% 50%;
    }

    50% {
      background-position:
        100% 50%;
    }

    100% {
      background-position:
        0% 50%;
    }

  }


  .hero-description {

    max-width:
      370px;

    margin:
      35px 0;

    color:
      #71809d;

    font-size:
      12px;

    line-height:
      1.8;

  }


  /* =========================================
     BUTTONS
  ========================================== */

  .hero-actions {

    display:
      flex;

    align-items:
      center;

    gap:
      20px;

  }


  .primary-button {

    display:
      flex;

    align-items:
      center;

    gap:
      20px;

    padding:
      15px 18px;

    color:
      #050816;

    background:
      #22d3ee;

    text-decoration:
      none;

    font-size:
      8px;

    font-weight:
      700;

    letter-spacing:
      0.14em;

    box-shadow:
      0 0 30px
      rgba(
        34,
        211,
        238,
        0.18
      );

    transition:
      transform
      0.3s ease,
      box-shadow
      0.3s ease;

  }


  .primary-button:hover {

    transform:
      translateY(-3px);

    box-shadow:
      0 0 45px
      rgba(
        34,
        211,
        238,
        0.35
      );

  }


  .arrow {

    font-size:
      15px;

  }


  .secondary-button {

    color:
      #71809d;

    text-decoration:
      none;

    font-size:
      8px;

    letter-spacing:
      0.15em;

    transition:
      color
      0.3s ease;

  }


  .secondary-button:hover {

    color:
      white;

  }


  /* =========================================
     CORE
  ========================================== */

  .core-area {

    position:
      relative;

    height:
      600px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

  }


  .core-glow {

    position:
      absolute;

    width:
      300px;

    height:
      300px;

    border-radius:
      50%;

    background:
      radial-gradient(
        circle,
        rgba(
          59,
          130,
          246,
          0.2
        ),
        transparent 70%
      );

    filter:
      blur(25px);

    animation:
      glowPulse
      4s ease-in-out
      infinite;

  }


  @keyframes glowPulse {

    0%,
    100% {
      transform:
        scale(0.9);

      opacity:
        0.7;
    }

    50% {
      transform:
        scale(1.2);

      opacity:
        1;
    }

  }


  .core {

    position:
      relative;

    width:
      130px;

    height:
      130px;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    border:
      1px solid
      rgba(
        34,
        211,
        238,
        0.6
      );

    border-radius:
      50%;

    background:
      radial-gradient(
        circle at 35% 30%,
        rgba(
          255,
          255,
          255,
          0.2
        ),
        rgba(
          59,
          130,
          246,
          0.08
        ) 45%,
        rgba(
          5,
          8,
          22,
          0.95
        )
      );

    box-shadow:
      0 0 50px
      rgba(
        34,
        211,
        238,
        0.2
      ),
      inset 0 0 40px
      rgba(
        59,
        130,
        246,
        0.15
      );

    z-index:
      5;

  }


  .core-inner {

    width:
      72px;

    height:
      72px;

    display:
      grid;

    place-items:
      center;

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.15
      );

    border-radius:
      50%;

    background:
      rgba(
        5,
        8,
        22,
        0.8
      );

    box-shadow:
      0 0 30px
      rgba(
        139,
        92,
        246,
        0.2
      );

  }


  .core-inner span {

    color:
      #22d3ee;

    font-size:
      20px;

    font-weight:
      700;

    letter-spacing:
      0.05em;

    text-shadow:
      0 0 20px
      rgba(
        34,
        211,
        238,
        0.8
      );

  }


  /* =========================================
     RINGS
  ========================================== */

  .core-ring {

    position:
      absolute;

    border:
      1px solid
      rgba(
        59,
        130,
        246,
        0.18
      );

    border-radius:
      50%;

    pointer-events:
      none;

  }


  .ring-one {

    width:
      250px;

    height:
      250px;

    transform:
      rotateX(65deg);

    animation:
      ringOne
      12s linear
      infinite;

  }


  .ring-two {

    width:
      350px;

    height:
      350px;

    transform:
      rotateY(65deg)
      rotateZ(20deg);

    border-color:
      rgba(
        139,
        92,
        246,
        0.16
      );

    animation:
      ringTwo
      18s linear
      infinite;

  }


  .ring-three {

    width:
      450px;

    height:
      450px;

    transform:
      rotateX(70deg)
      rotateZ(45deg);

    border-color:
      rgba(
        34,
        211,
        238,
        0.1
      );

    animation:
      ringThree
      25s linear
      infinite;

  }


  @keyframes ringOne {

    to {
      transform:
        rotateX(65deg)
        rotateZ(360deg);
    }

  }


  @keyframes ringTwo {

    to {
      transform:
        rotateY(65deg)
        rotateZ(-340deg);
    }

  }


  @keyframes ringThree {

    to {
      transform:
        rotateX(70deg)
        rotateZ(405deg);
    }

  }


  /* =========================================
     DATA POINTS
  ========================================== */

  .data-point {

    position:
      absolute;

    display:
      flex;

    align-items:
      center;

    gap:
      7px;

    color:
      #71809d;

    font-size:
      7px;

    letter-spacing:
      0.15em;

  }


  .data-point span {

    width:
      5px;

    height:
      5px;

    border-radius:
      50%;

    background:
      #3b82f6;

    box-shadow:
      0 0 10px
      #3b82f6;

  }


  .point-one {
    top:
      17%;

    left:
      22%;
  }


  .point-two {
    top:
      28%;

    right:
      12%;
  }


  .point-three {
    bottom:
      25%;

    left:
      12%;
  }


  .point-four {
    bottom:
      17%;

    right:
      20%;
  }


  /* =========================================
     SYSTEM PANEL
  ========================================== */

  .system-panel {

    border:
      1px solid
      rgba(
        255,
        255,
        255,
        0.08
      );

    background:
      rgba(
        11,
        18,
        37,
        0.65
      );

    backdrop-filter:
      blur(20px);

  }


  .panel-header {

    display:
      flex;

    justify-content:
      space-between;

    padding:
      18px;

    border-bottom:
      1px solid
      rgba(
        255,
        255,
        255,
        0.07
      );

    color:
      #71809d;

    font-size:
      7px;

    letter-spacing:
      0.15em;

  }


  .project-mini {

    display:
      grid;

    grid-template-columns:
      30px
      1fr
      10px;

    align-items:
      center;

    gap:
      10px;

    padding:
      20px;

    border-bottom:
      1px solid
      rgba(
        255,
        255,
        255,
        0.05
      );

    transition:
      background
      0.3s ease;

  }


  .project-mini:hover,
  .project-mini.active {

    background:
      rgba(
        59,
        130,
        246,
        0.08
      );

  }


  .project-number {

    color:
      #3b82f6;

    font-size:
      8px;

  }


  .project-mini strong {

    display:
      block;

    color:
      #eaf2ff;

    font-size:
      9px;

    letter-spacing:
      0.08em;

  }


  .project-mini small {

    display:
      block;

    margin-top:
      5px;

    color:
      #71809d;

    font-size:
      7px;

    letter-spacing:
      0.08em;

  }


  .project-status {

    color:
      #22d3ee;

    font-size:
      8px;

  }


  .future {

    opacity:
      0.45;

  }


  /* =========================================
     FOOTER
  ========================================== */

  .hero-footer {

    position:
      absolute;

    bottom:
      0;

    left:
      0;

    width:
      100%;

    z-index:
      15;

    display:
      grid;

    grid-template-columns:
      repeat(4, 1fr);

    border-top:
      1px solid
      rgba(
        255,
        255,
        255,
        0.07
      );

    background:
      rgba(
        5,
        8,
        22,
        0.5
      );

    backdrop-filter:
      blur(15px);

  }


  .hero-footer > div {

    padding:
      15px 25px;

    border-right:
      1px solid
      rgba(
        255,
        255,
        255,
        0.06
      );

    font-size:
      7px;

    letter-spacing:
      0.12em;

  }


  .footer-label {

    display:
      block;

    margin-bottom:
      5px;

    color:
      #3b82f6;

  }


  .hero-footer > div span:last-child {

    color:
      #71809d;

  }


  .online {

    color:
      #22d3ee !important;

  }


  .scroll-indicator {

    text-align:
      right;

    color:
      #71809d;

  }


  .scroll-indicator span {

    margin-left:
      10px;

    color:
      #22d3ee;

    font-size:
      12px;

  }


  /* =========================================
     TABLET
  ========================================== */

  @media (max-width: 1100px) {

    .hero-layout {

      grid-template-columns:
        1fr
        1fr;

    }

    .system-panel {

      display:
        none;

    }

    .core-area {

      position:
        absolute;

      right:
        0;

      width:
        55%;

      opacity:
        0.8;

    }

  }


  /* =========================================
     MOBILE
  ========================================== */

  @media (max-width: 700px) {

    .nav {

      height:
        65px;

      padding:
        0 20px;

    }

    .nav-links {

      display:
        none;

    }

    .system-status {

      font-size:
        7px;

    }

    .hero-layout {

      display:
        block;

      padding:
        100px 25px
        110px;

    }

    .hero-left {

      padding-top:
        30px;

    }

    h1 {

      font-size:
        clamp(
          55px,
          16vw,
          90px
        );

    }

    .core-area {

      position:
        absolute;

      top:
        45%;

      right:
        -25%;

      width:
        100%;

      height:
        400px;

      opacity:
        0.45;

    }

    .ring-one {
      width:
        190px;

      height:
        190px;
    }

    .ring-two {
      width:
        270px;

      height:
        270px;
    }

    .ring-three {
      width:
        340px;

      height:
        340px;
    }

    .hero-footer {

      grid-template-columns:
        1fr
        1fr;

    }

    .hero-footer > div:nth-child(2),
    .hero-footer > div:nth-child(3) {

      display:
        none;

    }

    .hero-footer > div {

      padding:
        12px 15px;

    }

  }

</style>


<script>

  import gsap from "gsap";


  const initHero = () => {

    const hero =
      document.querySelector(".hero");

    if (!hero) return;


    const elements = [
      ".nav",
      ".eyebrow",
      ".hero h1",
      ".hero-description",
      ".hero-actions",
      ".system-panel",
      ".hero-footer"
    ];


    gsap.set(elements, {
      opacity: 0,
      y: 30
    });


    const timeline =
      gsap.timeline({
        delay: 0.2
      });


    timeline
      .to(".nav", {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: "power3.out"
      })
      .to(".eyebrow", {
        opacity: 1,
        y: 0,
        duration: 0.5,
        ease: "power3.out"
      })
      .to(".hero h1", {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: "power4.out"
      }, "-=0.25")
      .to(".hero-description", {
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: "power3.out"
      }, "-=0.5")
      .to(".hero-actions", {
        opacity: 1,
        y: 0,
        duration: 0.5,
        ease: "power3.out"
      }, "-=0.35")
      .to(".system-panel", {
        opacity: 1,
        y: 0,
        duration: 0.7,
        ease: "power3.out"
      }, "-=0.5")
      .to(".hero-footer", {
        opacity: 1,
        y: 0,
        duration: 0.5,
        ease: "power3.out"
      }, "-=0.35");


    /* =====================================
       MOUSE CORE MOVEMENT
    ====================================== */

    const core =
      hero.querySelector(".core-area");

    let mouseX = 0;
    let mouseY = 0;

    let smoothX = 0;
    let smoothY = 0;


    hero.addEventListener(
      "pointermove",
      (event) => {

        const rect =
          hero.getBoundingClientRect();

        mouseX =
          (
            event.clientX -
            rect.left
          ) /
            rect.width -
          0.5;

        mouseY =
          (
            event.clientY -
            rect.top
          ) /
            rect.height -
          0.5;

      }
    );


    hero.addEventListener(
      "pointerleave",
      () => {

        mouseX = 0;
        mouseY = 0;

      }
    );


    const animate =
      () => {

        smoothX +=
          (mouseX - smoothX) *
          0.04;

        smoothY +=
          (mouseY - smoothY) *
          0.04;


        if (core) {

          gsap.set(core, {
            x: smoothX * 25,
            y: smoothY * 20,
            rotateY: smoothX * 5,
            rotateX: -smoothY * 5
          });

        }


        requestAnimationFrame(
          animate
        );

      };


    animate();


    /* =====================================
       PROJECT HOVER
    ====================================== */

    const projects =
      hero.querySelectorAll(
        ".project-mini"
      );


    projects.forEach(
      (project) => {

        project.addEventListener(
          "mouseenter",
          () => {

            gsap.to(
              project,
              {
                x: 6,
                duration: 0.3,
                ease: "power3.out"
              }
            );

          }
        );


        project.addEventListener(
          "mouseleave",
          () => {

            gsap.to(
              project,
              {
                x: 0,
                duration: 0.3,
                ease: "power3.out"
              }
            );

          }
        );

      }
    );

  };


  if (
    document.readyState ===
    "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      initHero,
      { once: true }
    );

  } else {

    initHero();

  }

</script>