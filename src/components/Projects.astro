---
import GitHubLink from "./GitHubLink.astro";
---
<section class="projects" id="projects">

  <div class="section-header">

    <div>
      <span class="eyebrow">02 / SELECTED WORK</span>

      <h2>
        PROJECT<br />
        <span>SYSTEMS.</span>
      </h2>
    </div>

    <p class="section-description">
      A selection of AI systems, software products and digital
      experiences engineered to solve real-world problems.
    </p>

  </div>


  <div class="projects-grid">

    <!-- =========================
         PROJECT 01
    ========================== -->

    <article class="project-card featured">

      <div class="project-top">

        <span class="project-number">
          01
        </span>

        <span class="project-year">
          2026
        </span>

      </div>


      <div class="project-content">

        <span class="project-type">
          AI / MACHINE LEARNING
        </span>

        <h3>
          AI CHATBOT
        </h3>

        <p>
          An intelligent conversational system designed to
          understand natural language, process context and
          generate useful responses in real time.
        </p>


        <div class="tags">

          <span>PYTHON</span>
          <span>OPENAI</span>
          <span>FASTAPI</span>

        </div>


        <div class="project-actions">
          <a href="/projects/ai-chatbot" class="project-link">VIEW PROJECT <span>↗</span></a>
          <a href="/projects/ai-chatbot#demo" class="project-link secondary-link">LIVE DEMO <span>↗</span></a>
          <GitHubLink project="ai-chatbot" />
        </div>

      </div>


      <!-- VISUAL -->

      <div class="project-visual">

        <div class="visual-grid"></div>

        <div class="core">

          <div class="core-ring ring-one"></div>

          <div class="core-ring ring-two"></div>

          <div class="core-ring ring-three"></div>

          <div class="core-center"></div>

        </div>

        <span class="signal signal-1">
          AI
        </span>

        <span class="signal signal-2">
          01
        </span>

        <span class="signal signal-3">
          CORE
        </span>

      </div>

    </article>


    <!-- =========================
         PROJECT 02
    ========================== -->

    <article class="project-card">

      <div class="project-top">

        <span class="project-number">
          02
        </span>

        <span class="project-year">
          SOFTWARE
        </span>

      </div>


      <div class="project-content">

        <span class="project-type">
          SOFTWARE / AUTOMATION
        </span>

        <h3>
          BUSINESS<br />
          OS
        </h3>

        <p>
          A centralized digital platform connecting business
          workflows, automation and intelligent agents.
        </p>


        <div class="tags">

          <span>REACT</span>
          <span>NODE</span>
          <span>DATABASE</span>

        </div>


        <div class="project-actions">
        <a href="/projects/business-os" class="project-link">
          VIEW PROJECT
          <span>↗</span>
        </a>
          <a href="/demos/business-os" class="project-link">LIVE DEMO <span>↗</span></a>
          <GitHubLink project="business-os" />
        </div>

      </div>

    </article>


    <!-- =========================
         PROJECT 03
    ========================== -->

    <article class="project-card">

      <div class="project-top">

        <span class="project-number">
          03
        </span>

        <span class="project-year">
          DIGITAL
        </span>

      </div>


      <div class="project-content">

        <span class="project-type">
          WEB / EXPERIENCE
        </span>

        <h3>
          DIGITAL<br />
          EXPERIENCE
        </h3>

        <p>
          Experimental interfaces combining technology,
          motion and immersive digital design.
        </p>


        <div class="tags">

          <span>ASTRO</span>
          <span>THREE.JS</span>
          <span>WEBGL</span>

        </div>


        <div class="project-actions">
        <a href="/projects/digital-experience" class="project-link">
          VIEW PROJECT
          <span>↗</span>
        </a>
          <GitHubLink project="digital-experience" />
        </div>

      </div>

    </article>

  </div>

</section>


<style>

  /* ================================
     SECTION
  ================================= */

  .projects {

    position: relative;

    padding:
      150px 6vw
      140px;

    background: #050714;

    border-top:
      1px solid
      rgba(255,255,255,.06);

    overflow: hidden;

  }


  /* ================================
     BACKGROUND
  ================================= */

  .projects::before {

    content: "";

    position: absolute;

    inset: 0;

    background:

      radial-gradient(
        circle at 75% 25%,
        rgba(50,80,220,.10),
        transparent 35%
      ),

      linear-gradient(
        rgba(60,100,180,.035) 1px,
        transparent 1px
      ),

      linear-gradient(
        90deg,
        rgba(60,100,180,.035) 1px,
        transparent 1px
      );

    background-size:
      auto,
      80px 80px,
      80px 80px;

    pointer-events: none;

  }


  /* ================================
     HEADER
  ================================= */

  .section-header {

    position: relative;

    z-index: 2;

    display: flex;

    justify-content:
      space-between;

    align-items:
      flex-end;

    gap: 60px;

    margin-bottom: 75px;

  }


  .eyebrow {

    color: #22d3ee;

    font-family: monospace;

    font-size: 9px;

    letter-spacing: .22em;

  }


  h2 {

    margin:
      18px 0 0;

    color: #eef2ff;

    font-size:
      clamp(
        60px,
        8vw,
        120px
      );

    line-height: .82;

    letter-spacing:
      -.07em;

    font-weight: 700;

  }


  h2 span {

    color: #526df4;

  }


  .section-description {

    max-width: 390px;

    margin: 0;

    color: #737d98;

    font-size: 13px;

    line-height: 1.8;

  }


  /* ================================
     GRID
  ================================= */

  .projects-grid {

    position: relative;

    z-index: 2;

    display: grid;

    grid-template-columns:
      1fr 1fr;

    gap: 18px;

  }


  /* ================================
     CARD
  ================================= */

  .project-card {

    position: relative;

    min-height: 480px;

    padding: 34px;

    overflow: hidden;

    background:
      linear-gradient(
        145deg,
        rgba(15,22,48,.92),
        rgba(7,10,24,.94)
      );

    border:
      1px solid
      rgba(110,130,190,.15);

    transition:
      transform .4s cubic-bezier(.2,.8,.2,1),
      border-color .4s ease,
      box-shadow .4s ease;

  }


  .project-card:hover {

    transform:
      translateY(-8px);

    border-color:
      rgba(90,120,220,.4);

    box-shadow:
      0 30px 80px
      rgba(0,0,0,.35);

  }


  .project-card.featured {

    grid-column:
      span 2;

    min-height:
      530px;

  }


  /* ================================
     TOP
  ================================= */

  .project-top {

    display: flex;

    align-items: center;

    justify-content:
      space-between;

  }


  .project-number {

    color: #22d3ee;

    font-family: monospace;

    font-size: 10px;

    letter-spacing: .18em;

  }


  .project-year {

    color: #424b66;

    font-family: monospace;

    font-size: 8px;

    letter-spacing: .14em;

  }


  /* ================================
     CONTENT
  ================================= */

  .project-content {

    position: relative;

    z-index: 5;

    max-width:
      480px;

    margin-top:
      90px;

  }


  .project-type {

    color: #66718e;

    font-family: monospace;

    font-size: 8px;

    letter-spacing: .16em;

  }


  h3 {

    margin:
      14px 0 20px;

    color: #edf1ff;

    font-size:
      clamp(
        36px,
        4vw,
        58px
      );

    line-height: .9;

    letter-spacing:
      -.055em;

    font-weight: 700;

  }


  .project-content p {

    max-width:
      410px;

    margin: 0;

    color: #77819a;

    font-size: 13px;

    line-height: 1.8;

  }


  /* ================================
     TAGS
  ================================= */

  .tags {

    display: flex;

    flex-wrap: wrap;

    gap: 7px;

    margin-top: 28px;

  }


  .tags span {

    padding:
      7px 10px;

    color: #77819a;

    background:
      rgba(255,255,255,.025);

    border:
      1px solid
      rgba(255,255,255,.08);

    font-family: monospace;

    font-size: 8px;

    letter-spacing: .1em;

    transition:
      border-color .3s ease,
      color .3s ease;

  }


  .project-card:hover
  .tags span {

    border-color:
      rgba(80,110,200,.25);

    color: #aeb8d0;

  }


  /* ================================
     LINK
  ================================= */

  .project-actions { --github-link-margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: auto; padding-top: 28px; }
  .project-actions :global(.github-link) { flex-basis: fit-content; }
  .project-card { display: flex; flex-direction: column; }
  .project-content { display: flex; flex-direction: column; align-items: flex-start; flex: 1; width: 100%; }
  .project-actions .project-link { margin-top: 0; min-height: 44px; }
  @media (max-width: 400px) {
    .project-actions { width: 100%; }
    .project-actions :global(.github-link) { width: 100%; font-size: 10px; }
  }
  .secondary-link { color:#22d3ee; }

  .project-link {

    display:
      inline-flex;

    align-items:
      center;

    gap: 25px;

    margin-top:
      34px;

    color: #dce4f7;

    text-decoration:
      none;

    font-family: monospace;

    font-size: 9px;

    letter-spacing: .15em;

    transition:
      color .3s ease;

  }


  .project-link span {

    font-size:
      17px;

    transition:
      transform .3s ease;

  }


  .project-link:hover {

    color: #22d3ee;

  }


  .project-link:hover span {

    transform:
      translate(4px,-4px);

  }


  /* ================================
     AI VISUAL
  ================================= */

  .project-visual {

    position: absolute;

    right: 5%;

    top: 50%;

    width: 400px;

    height: 400px;

    transform:
      translateY(-50%);

    pointer-events:
      none;

  }


  .visual-grid {

    position: absolute;

    inset: 0;

    opacity: .35;

    background:

      linear-gradient(
        rgba(80,110,210,.08) 1px,
        transparent 1px
      ),

      linear-gradient(
        90deg,
        rgba(80,110,210,.08) 1px,
        transparent 1px
      );

    background-size:
      40px 40px;

    mask-image:
      radial-gradient(
        circle,
        black,
        transparent 70%
      );

  }


  .core {

    position: absolute;

    left: 50%;

    top: 50%;

    width: 170px;

    height: 170px;

    transform:
      translate(-50%,-50%);

    border-radius: 50%;

    background:

      radial-gradient(
        circle at 35% 30%,
        rgba(255,255,255,.3),
        rgba(70,90,220,.3) 25%,
        rgba(25,35,90,.9) 65%,
        transparent 72%
      );

    box-shadow:
      0 0 90px
      rgba(65,90,240,.3);

  }


  .core-ring {

    position: absolute;

    left: 50%;

    top: 50%;

    border:
      1px solid
      rgba(80,130,255,.4);

    border-radius: 50%;

    transform:
      translate(-50%,-50%);

  }


  .ring-one {

    width: 250px;

    height: 250px;

    animation:
      rotateOne 10s linear infinite;

  }


  .ring-two {

    width: 330px;

    height: 330px;

    border-color:
      rgba(140,90,255,.25);

    animation:
      rotateTwo 15s linear infinite;

  }


  .ring-three {

    width: 390px;

    height: 390px;

    border-color:
      rgba(60,180,255,.12);

    animation:
      rotateOne 22s linear infinite reverse;

  }


  .core-center {

    position: absolute;

    left: 50%;

    top: 50%;

    width: 12px;

    height: 12px;

    transform:
      translate(-50%,-50%);

    border-radius: 50%;

    background: #fff;

    box-shadow:
      0 0 25px
      rgba(255,255,255,.8);

  }


  @keyframes rotateOne {

    to {

      transform:
        translate(-50%,-50%)
        rotate(360deg);

    }

  }


  @keyframes rotateTwo {

    to {

      transform:
        translate(-50%,-50%)
        rotate(-360deg);

    }

  }


  /* ================================
     SIGNALS
  ================================= */

  .signal {

    position: absolute;

    color: #536486;

    font-family: monospace;

    font-size: 8px;

    letter-spacing: .15em;

  }


  .signal-1 {

    top: 35px;

    right: 55px;

  }


  .signal-2 {

    bottom: 55px;

    left: 35px;

  }


  .signal-3 {

    top: 50%;

    right: -5px;

  }


  /* ================================
     RESPONSIVE
  ================================= */

  @media (max-width: 900px) {

    .projects {

      padding:
        110px 25px;

    }


    .section-header {

      display: block;

    }


    .section-description {

      margin-top:
        35px;

    }


    .projects-grid {

      grid-template-columns:
        1fr;

    }


    .project-card.featured {

      grid-column:
        span 1;

    }


    .project-visual {

      right: -100px;

      opacity: .35;

    }

  }


  @media (max-width: 600px) {

    .projects {

      padding:
        90px 20px;

    }


    h2 {

      font-size:
        60px;

    }


    .project-card {

      min-height:
        450px;

      padding:
        25px;

    }


    .project-card.featured {

      min-height:
        500px;

    }


    .project-content {

      margin-top:
        70px;

    }


    .project-visual {

      right: -160px;

      opacity: .22;

      transform:
        translateY(-50%)
        scale(.8);

    }

  }

</style>
